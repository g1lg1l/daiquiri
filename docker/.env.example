# Daiq self-hosted configuration. Copy to docker/.env and replace EVERY value
# marked "change-me" (see docker/README.md → "Generate secrets").
# Never commit docker/.env.

# Public URL users open in the browser (scheme + host [+ port], no trailing slash).
DAIQ_PUBLIC_URL=http://localhost:3000
DAIQ_HTTP_PORT=3000

# --- Secrets (generate with: sh docker/supabase/utils/generate-keys.sh) -------------
POSTGRES_PASSWORD=change-me
JWT_SECRET=change-me-at-least-32-characters-long
ANON_KEY=change-me
SERVICE_ROLE_KEY=change-me
SECRET_KEY_BASE=change-me-at-least-64-characters-long
REALTIME_DB_ENC_KEY=change-me-16-chars
PG_META_CRYPTO_KEY=change-me-at-least-32-characters-long
DASHBOARD_USERNAME=daiq
DASHBOARD_PASSWORD=change-me

# --- Auth ------------------------------------------------------------------------------
JWT_EXPIRY=3600
DISABLE_SIGNUP=false
# Without SMTP, set this to true so new accounts can sign in immediately.
ENABLE_EMAIL_AUTOCONFIRM=false
# true enables "Try the demo": anonymous visitors get a private sandbox for 24 h.
ENABLE_ANONYMOUS_USERS=false

# Outgoing email (sign-up confirmation, magic links). Leave SMTP_HOST empty to disable.
SMTP_ADMIN_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SENDER_NAME=Daiq
