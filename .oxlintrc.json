{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "import", "react", "jsx-a11y", "vitest", "promise"],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "warn"
  },
  "ignorePatterns": [
    "**/dist/**",
    "**/routeTree.gen.ts",
    "**/database.types.ts",
    "supabase/**",
    "docs/**"
  ],
  "rules": {
    "typescript/no-explicit-any": "error",
    "typescript/no-non-null-assertion": "off",
    "typescript/no-floating-promises": "error",
    "typescript/no-misused-promises": "error",
    "typescript/await-thenable": "error",
    "typescript/no-unnecessary-type-assertion": "error",
    "typescript/consistent-type-imports": "error",
    "typescript/switch-exhaustiveness-check": "error",
    "eqeqeq": ["error", "smart"],
    "no-console": [
      "error",
      {
        "allow": ["warn", "error"]
      }
    ],
    "no-empty": "error",
    "react/rules-of-hooks": "error",
    "react/exhaustive-deps": "error",
    "react/jsx-key": "error",
    "react/react-in-jsx-scope": "off",
    "jsx-a11y/no-autofocus": "off",
    "import/no-cycle": "error",
    "import/no-default-export": "off",
    "unicorn/no-array-sort": "off",
    "oxc/no-map-spread": "off",
    "no-restricted-imports": [
      "error",
      {
        "paths": [
          {
            "name": "@supabase/supabase-js",
            "message": "Only packages/data may talk to Supabase (ADR-0003)."
          },
          {
            "name": "cmdk",
            "message": "Use the Command components from @daiq/ui (ADR-0008)."
          }
        ]
      }
    ],
    "consistent-return": "off",
    "typescript/consistent-return": "off",
    "react/incompatible-library": "off",
    "import/no-unassigned-import": [
      "error",
      {
        "allow": ["**/*.css", "@testing-library/jest-dom/vitest"]
      }
    ]
  },
  "overrides": [
    {
      "files": ["packages/data/**"],
      "rules": {
        "no-restricted-imports": "off"
      }
    },
    {
      "files": ["packages/ui/src/components/command.tsx"],
      "rules": {
        "no-restricted-imports": "off"
      }
    },
    {
      "files": ["**/*.test.ts", "**/*.test.tsx", "**/e2e/**"],
      "rules": {
        "typescript/no-floating-promises": "off"
      }
    },
    {
      "files": ["**/scripts/**"],
      "rules": {
        "no-console": "off"
      }
    },
    {
      "files": [
        "apps/web/src/features/tasks/task-list.tsx",
        "apps/web/src/features/tasks/task-board.tsx",
        "packages/editor/src/suggestion.tsx"
      ],
      "rules": {
        "jsx-a11y/prefer-tag-over-role": "off"
      }
    },
    {
      "files": ["packages/editor/src/editor.tsx"],
      "rules": {
        "react/refs": "off"
      }
    }
  ]
}
