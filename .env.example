# Build-time variables for apps/web (read by scripts/postbuild.mjs and vite.config.ts).
# Local development does not need any of these: `pnpm dev` writes
# apps/web/public/config.json from the local Supabase stack.

# Base path when hosted under a sub-path (GitHub Pages: /<repository>/).
DAIQ_BASE=/

# When set, the build writes dist/config.json for static hosting (the demo).
# Use ONLY the publishable/anon key. Never a service-role or secret key.
DAIQ_SUPABASE_URL=
DAIQ_SUPABASE_KEY=
DAIQ_DEMO=false

# Optional build identifier (busts the persisted client cache between releases).
VITE_BUILD_ID=
